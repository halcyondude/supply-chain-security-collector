{
  "name": "supply-chain-security-collector",
  "version": "1.0.0",
  "description": "Generic GraphQL data collection tool with DuckDB storage and Parquet export",
  "scripts": {
    "test": "npm run test:three",
    "start": "npm run landscape",
    "landscape": "ts-node src/neo.ts --input input/cncf-full-landscape.json --queries GetRepoDataExtendedInfo --analyze --parallel",
    "test:single": "ts-node src/neo.ts --input input/test-single-project.json --queries GetRepoDataExtendedInfo --analyze --parallel",
    "test:three": "ts-node src/neo.ts --input input/test-three-projects.json --queries GetRepoDataExtendedInfo --analyze --parallel",
    "test:simple": "ts-node src/neo.ts --input input/test-simple-format.json --queries GetRepoDataExtendedInfo --analyze",
    "collect": "ts-node src/neo.ts",
    "analyze": "ts-node src/analyze.ts",
    "report": "ts-node src/report-cli.ts",
    "graph": "ts-node src/graph/graph-cli.ts build",
    "graph:query": "ts-node src/graph/graph-cli.ts query",
    "graph:list": "ts-node src/graph/graph-cli.ts list",
    "fetch:landscape": "ts-node scripts/fetch-cncf-landscape.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "postinstall": "npm run codegen",
    "lint": "npx eslint src/",
    "lint:fix": "npx eslint src/ --fix",
    "format": "npx eslint src/ --fix",
    "typecheck": "npx tsc --noEmit",
    "clean": "rm -rf output .cache src/generated .virtual-documents .ipynb_checkpoints",
    "lab": "uv run jupyter lab",
    "lab:sbom-ci": "uv run jupyter lab notebooks/sbom-ci-analysis.ipynb",
    "lab:agg-tables": "uv run jupyter lab notebooks/agg_tables_overview.ipynb"
  },
  "keywords": [
    "graphql",
    "duckdb",
    "parquet",
    "data-engineering",
    "etl"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.2",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "graphql": "^16.15.0",
    "graphql-request": "^6.1.0",
    "lbug": "^0.14.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
